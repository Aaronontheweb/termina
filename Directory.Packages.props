<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- NuGet package versions -->
    <SystemReactiveVersion>6.1.0</SystemReactiveVersion>
    <MicrosoftExtensionsVersion>10.0.10</MicrosoftExtensionsVersion>
  </PropertyGroup>
  <!-- App dependencies -->
  <ItemGroup>
    <PackageVersion Include="CsCheck" Version="4.8.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Akka.Hosting" Version="1.5.70" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="R3" Version="1.3.1" />
    <PackageVersion Include="Verify.Xunit" Version="31.12.5" />
  </ItemGroup>
  <!-- Transitive dependency override (security): Akka.Hosting pulls in
       OpenTelemetry.Api 1.9.0 transitively, which is affected by CVE-2026-40894
       (GHSA-g94r-2vxg-569j). Pin it up to the first patched release. -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Api" Version="1.16.0" />
  </ItemGroup>
  <!-- Transitive dependency override (security): Microsoft.CodeAnalysis.CSharp.Analyzer.Testing
       pulls in NuGet.Packaging 7.0.3, which needs System.Security.Cryptography.Pkcs 9.0.6.
       That version is affected by GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. Pin it up to
       the first patched release for net10.0. Test project only; no shipped package uses it. -->
  <ItemGroup>
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <!-- Benchmark dependencies -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <!-- SourceLink support -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.303" />
  </ItemGroup>
  <!-- Source generator dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>
  <!-- Analyzer testing dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
  </ItemGroup>
</Project>